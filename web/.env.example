# Copy to .env.local for local development. Never commit real values.
# Neon Connect dialog: pooled PostgreSQL URL, including sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Exact browser origin, without a path or trailing slash.
# Set to https://your-domain.example on Vercel (no localhost in production).
APP_ORIGIN=http://localhost:3000

# Run npm run admin:credentials to generate the password hash and session secret.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=


# Ed25519 PKCS8 DER, base64. Server only; never put in NEXT_PUBLIC variables.
LICENSE_SIGNING_PRIVATE_KEY=
